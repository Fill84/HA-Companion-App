{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Bundled main webview only; the remote Home Assistant webview receives no IPC capability",
  "webviews": ["main"],
  "permissions": [
    "core:default",
    "core:webview:deny-internal-toggle-devtools",
    "allow-get-settings",
    "allow-get-integration-version",
    "allow-save-settings",
    "allow-register-device",
    "allow-reregister-device",
    "allow-check-connection",
    "allow-get-sensor-list",
    "allow-get-sensor-diagnostics",
    "allow-update-sensors-now",
    "allow-toggle-sensor",
    "allow-get-current-language",
    "allow-get-my-public-ip",
    "allow-load-dashboard",
    "allow-hide-dashboard"
  ]
}
